{
  "version": "2.2.0",
  "name": "Neo-SPC Generation Harness",
  "design_principle": "Deterministic controls with seeded variants; no unbounded random generation.",
  "sections": {
    "harmony": {
      "key": {
        "type": "pitch_class",
        "default": 0
      },
      "scale_id": {
        "type": "enum",
        "source": "scale-library-v2.2.json",
        "default": "ionian"
      },
      "progression_id": {
        "type": "enum",
        "source": "chord-progression-library-v2.2.json",
        "default": "maj_pop_01"
      },
      "harmonic_rhythm": {
        "type": "range",
        "min": 0.25,
        "max": 4,
        "default": 1,
        "unit": "bars/chord"
      },
      "non_diatonic_budget": {
        "type": "range",
        "min": 0,
        "max": 0.55,
        "default": 0.08
      },
      "voice_leading_weight": {
        "type": "range",
        "min": 0,
        "max": 1,
        "default": 0.82
      },
      "cadence_strength": {
        "type": "range",
        "min": 0,
        "max": 1,
        "default": 0.62
      },
      "inversion_rate": {
        "type": "range",
        "min": 0,
        "max": 1,
        "default": 0.28
      }
    },
    "arp": {
      "preset": {
        "type": "enum",
        "source": "pattern-preset-library-v2.2.json#arpeggio"
      },
      "density": {
        "type": "range",
        "min": 0,
        "max": 1,
        "default": 0.45
      },
      "note_repeats": {
        "type": "integer",
        "min": 0,
        "max": 4,
        "default": 0
      },
      "on_beat": {
        "type": "range",
        "min": 0,
        "max": 1,
        "default": 0.58
      },
      "articulation": {
        "type": "range",
        "min": 0,
        "max": 1,
        "default": 0.55
      },
      "pattern_bias": {
        "type": "range",
        "min": 0,
        "max": 1,
        "default": 0.5
      },
      "morphing": {
        "type": "range",
        "min": 0,
        "max": 1,
        "default": 0.18
      }
    },
    "bassline": {
      "preset": {
        "type": "enum",
        "source": "pattern-preset-library-v2.2.json#bassline"
      },
      "density": {
        "type": "range",
        "min": 0,
        "max": 1,
        "default": 0.42
      },
      "non_roots": {
        "type": "range",
        "min": 0,
        "max": 1,
        "default": 0.25
      },
      "transitions": {
        "type": "range",
        "min": 0,
        "max": 1,
        "default": 0.32
      },
      "on_beat": {
        "type": "range",
        "min": 0,
        "max": 1,
        "default": 0.66
      },
      "pattern_bias": {
        "type": "range",
        "min": 0,
        "max": 1,
        "default": 0.55
      },
      "morphing": {
        "type": "range",
        "min": 0,
        "max": 1,
        "default": 0.2
      }
    },
    "humanize": {
      "profile": {
        "type": "enum",
        "source": "pattern-preset-library-v2.2.json#humanize"
      },
      "timing_depth": {
        "type": "range",
        "min": 0,
        "max": 1,
        "default": 0.25
      },
      "dynamics_depth": {
        "type": "range",
        "min": 0,
        "max": 1,
        "default": 0.35
      },
      "strum_time_ms": {
        "type": "range",
        "min": 0,
        "max": 80,
        "default": 16
      },
      "strum_curve": {
        "type": "range",
        "min": -1,
        "max": 1,
        "default": 0
      },
      "phrasing_weight": {
        "type": "range",
        "min": 0,
        "max": 1,
        "default": 0.65
      },
      "phrasing_offset": {
        "type": "range",
        "min": -1,
        "max": 1,
        "default": 0
      }
    },
    "chop": {
      "preset": {
        "type": "enum",
        "source": "pattern-preset-library-v2.2.json#chop"
      },
      "density": {
        "type": "range",
        "min": 0,
        "max": 1,
        "default": 0.3
      },
      "sub_cycles": {
        "type": "integer",
        "min": 1,
        "max": 8,
        "default": 2
      },
      "on_beat": {
        "type": "range",
        "min": 0,
        "max": 1,
        "default": 0.55
      },
      "onset_skew": {
        "type": "range",
        "min": -1,
        "max": 1,
        "default": 0
      },
      "pattern_bias": {
        "type": "range",
        "min": 0,
        "max": 1,
        "default": 0.5
      },
      "morphing": {
        "type": "range",
        "min": 0,
        "max": 1,
        "default": 0.12
      }
    },
    "mix": {
      "master_volume_db": {
        "type": "range",
        "min": -36,
        "max": 6,
        "default": -3
      },
      "ceiling_dbfs": {
        "type": "range",
        "min": -12,
        "max": 0,
        "default": -1
      },
      "lead_priority": {
        "type": "range",
        "min": 0,
        "max": 1,
        "default": 0.72
      },
      "drum_presence": {
        "type": "range",
        "min": 0,
        "max": 1,
        "default": 0.64
      },
      "bass_weight": {
        "type": "range",
        "min": 0,
        "max": 1,
        "default": 0.55
      },
      "atmosphere_width": {
        "type": "range",
        "min": 0,
        "max": 1,
        "default": 0.6
      }
    },
    "transport": {
      "tempo_multiplier": {
        "type": "range",
        "min": 0.6,
        "max": 1.5,
        "default": 1.0,
        "center": 1.0
      }
    }
  },
  "hard_rules": [
    "Generate core reduction before ornament layers.",
    "Seeded variation must preserve phrase function.",
    "Chord tones and structural scale tones receive higher metric priority.",
    "Pattern morphing changes one axis at a time.",
    "Fast-tempo detail cannot increase every layer simultaneously.",
    "Mix controls never substitute for arrangement review."
  ]
}